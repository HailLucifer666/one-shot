# RecipeBox environment configuration (copy to .env to use).
# All values have safe local defaults; everything is optional for a local run.

# Port the server listens on.
PORT=3000

# Directory for db.json and uploaded photos. Defaults to ./data inside the project.
DATA_DIR=

# Seeded admin account (created on first start if no admin exists).
ADMIN_EMAIL=admin@recipebox.local
ADMIN_PASSWORD=admin-password-123
