# Cutwell configuration — copy to .env and adjust. All variables are optional.

# Port for the HTTP server.
PORT=3000

# Directory for the SQLite database file (created automatically).
DATA_DIR=./data

# Directory where confirmation/cancellation email text files are written.
OUTBOX_DIR=./outbox

# Testing clock override: an ISO 8601 instant, e.g. 2027-03-13T12:00:00Z
# (or with an offset, e.g. 2027-03-13T06:00:00-06:00).
# Leave empty to use the real system clock. See README "Setting the clock for testing".
CUTWELL_NOW=

# Seeded demo accounts created on first start. These are demo values for local
# development only, NOT production credentials — override them before any real use.
SEED_ADMIN_EMAIL=admin@cutwell.test
SEED_ADMIN_PASSWORD=cutwell-admin-1
SEED_STYLIST_PASSWORD=cutwell-stylist-1
