# Cutwell Salon booking app - example environment file.
# Copy to .env and adjust. Every variable is optional; defaults are shown.

# HTTP port
PORT=3000

# CLOCK OVERRIDE FOR TESTING (documented in README "Setting the current time").
# ISO 8601 datetime, interpreted as UTC. Leave empty for the real clock.
# Example: 2027-03-13T06:00:00Z
APP_NOW=

# SQLite database file (relative paths resolve against the project root)
DB_PATH=data/cutwell.db

# Folder where fake confirmation/cancellation emails are written as .txt files
OUTBOX_DIR=outbox

# Seed passwords for the local demo accounts created on first start.
# These are DEMO credentials for local development only, not real secrets.
SEED_ADMIN_PASSWORD=cutwell-admin
SEED_STYLIST_PASSWORD=stylist-pass-1
SEED_DEMO_CUSTOMER_PASSWORD=customer-pass-1
